# ==============================================================================
# MeetMind AI - Environment Variables Template
# Copy this file to '.env' at the project root and fill in your actual credentials.
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & Edge Functions Configuration
# Get these from your Supabase Project Settings -> API & Database
# ------------------------------------------------------------------------------
# Public URL of your Supabase project (used by both client and backend)
VITE_SUPABASE_URL=
SUPABASE_URL=

# Public Anon / Client Key (safe for frontend queries)
VITE_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

# Server-Side Service Role Key (Keep private! NEVER expose in browser code)
SUPABASE_SERVICE_ROLE_KEY=

# Optional Webhook Secret to authenticate Supabase Database Webhook calls
SUPABASE_WEBHOOK_SECRET=
