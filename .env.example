# ==============================================================================
# MeetMind AI - Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Supabase PostgreSQL & Client Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------------------------------------------
# 3. Supabase Server-Side Service Role Key (Keep private! Never expose to browser)
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 4. Supabase Database Webhook Authentication Secret
# ------------------------------------------------------------------------------
SUPABASE_WEBHOOK_SECRET=your_webhook_secret
